# Trigger CI by editing this file when you need a manual redeploy.
# Last triggered: 2026-08-30
subscription_id    = "<exit-subscription-id>"
location           = "swedencentral"
name_prefix        = "exit"
shopify_api_key    = "replace-me"
shopify_api_secret = "replace-me"

# SSH public key for the Terraform CI runner VM (required).
ci_runner_ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Default false (private Key Vault only). CI enables public access only for GitHub-hosted bootstrap.
# key_vault_public_network_access_enabled = false
